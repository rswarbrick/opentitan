name: "lowrisc:fpv:tlul_adapter_reg_fpv:0.1"
description: "tlul_adapter_reg FPV target"
filesets:
  files_formal:
    depend:
      - lowrisc:ip:tlul
    files:
      - tb/tlul_adapter_reg_tb.sv
      - vip/tlul_adapter_reg_assert_fpv.sv
    file_type: systemVerilogSource

targets:
  formal:
    flow: sim
    flow_options:
      tool: icarus
    filesets:
      - files_formal
    toplevel: tlul_adapter_reg_tb
